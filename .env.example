# Copy this file to  .env  (same folder) and fill in your values. The .env file is git-ignored and is
# never put in the ZIP. Real environment variables of the same name take priority over this file.

# HackerOne Hacker API (Settings -> API Token on hackerone.com). The username is the one the token was created for.
H1_API_USERNAME=
H1_API_TOKEN=

# OpenRouter: used for the embeddings (openai/text-embedding-3-large) and for the "When to try this" LLM.
OPENROUTER_API_KEY=

# OPTIONAL. GitLab only returns the COMMENTS of an issue to a logged-in token. Without it everything else still works;
# comments are just skipped. Create a read-only personal access token (scope: read_api) on gitlab.com.
# GITLAB_TOKEN=

# OPTIONAL. Only for `ask` and `eval answers`, which need an answer model (config.toml [defaults] answer / judge).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
